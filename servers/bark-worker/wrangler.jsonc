{
    "name": "bark-worker",
    "main": "main.js",
    "compatibility_date": "2026-03-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "database",
            "database_name": "database-bark",
            "database_id": "b0b069ad-f7de-4054-9141-3e3a68faeeb7"
        }
    ],
    "keep_vars": true,
    "vars": {
        "ALLOW_NEW_DEVICE": "true",
        "ALLOW_QUERY_NUMS": "true",
        "ROOT_PATH": "/",
        // "BASIC_AUTH": ""
    },
    // Volumetric abuse protection, checked before Basic Auth or any D1 work
    // runs (see the checkRateLimit function in main.js/main_kv.js).
    // `namespace_id` here is just a local identifier for this binding within
    // this Worker script, not a real resource to provision.
    "unsafe": {
        "bindings": [
            {
                "name": "RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "1001",
                "simple": { "limit": 60, "period": 60 }
            }
        ]
    }
}