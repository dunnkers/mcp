{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vinted-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// global_fetch_strictly_public: required by the OAuth provider for CIMD
	// (claude.ai identifies itself with a client metadata URL), and keeps
	// Worker fetches from reaching private addresses.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true,
	},
	// Stores OAuth clients, grants, and tokens issued by
	// @cloudflare/workers-oauth-provider. The real namespace id is
	// account-specific and isn't committed here (this is a public repo) —
	// the deploy workflow substitutes it from the CLOUDFLARE_OAUTH_KV_NAMESPACE_ID
	// repository secret before running `wrangler deploy`, same pattern as
	// marktplaats-mcp's wrangler.jsonc in this repo.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "00000000000000000000000000000000",
		},
	],
	// AUTH_TOKEN (the /authorize consent-page password) is set as a secret
	// (`wrangler secret put AUTH_TOKEN`), not here.
	//
	// Volumetric abuse protection, checked before auth or any real work runs.
	// Rate-limit namespace ids are account-wide: Workers that share an id share
	// counters, so each Worker in this repo uses its own (bark-worker 1001,
	// marktplaats-mcp 1002, vinted-mcp 1003). Not a resource to provision.
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 60, "period": 60 },
		},
	],
}
